<!-- we aare using if becoz khale alert na aaye taki 
 sucess ek array so print alert when
if koi add hue h listing ie sucess ke length zero se bdee h , -->

<!-- views/includes/flash.ejs -->
<% let success = locals.success || []; %>
<% let error = locals.error || []; %>

<% if (success.length > 0) { %>
  <% success.forEach(msg => { %>
    <div class="alert alert-info alert-dismissible fade show col-6 offset-3" role="alert">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }) %>
<% } %>

<% if (error.length > 0) { %>
  <% error.forEach(msg => { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }) %>
<% } %>
