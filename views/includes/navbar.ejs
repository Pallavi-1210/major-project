<style>
  /* 2026 Modern Luxury Boutique Design System - Cream & Sage Green Palette */
  .custom-navbar {
    background: rgba(252, 252, 248, 0.92) !important;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid #E6EADF !important;
    padding: 0.75rem 1.5rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(95, 141, 122, 0.05);
  }

  .navbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .brand-icon {
    font-size: 1.25rem;
    color: #5F8D7A;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(95, 141, 122, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar-brand:hover .brand-icon {
    transform: scale(1.08) rotate(-5deg);
    background: rgba(95, 141, 122, 0.18);
    color: #4E7867;
  }

  .brand-title {
    font-weight: 700;
    font-size: 1.35rem;
    color: #5F8D7A;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .navbar-brand:hover .brand-title {
    color: #4E7867;
  }

  .nav-link {
    font-weight: 500;
    color: #2F2F2F !important;
    padding: 0.5rem 1rem !important;
    border-radius: 25px;
    transition: all 0.25s ease;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
  }

  .nav-link:hover {
    color: #5F8D7A !important;
    background-color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(95, 141, 122, 0.08);
  }

  .nav-btn-login {
    border: 1.5px solid #5F8D7A !important;
    color: #5F8D7A !important;
    background: transparent !important;
    padding: 0.45rem 1.2rem !important;
    font-weight: 600 !important;
    border-radius: 25px !important;
    margin-left: 0.25rem;
  }

  .nav-btn-login:hover {
    background-color: #5F8D7A !important;
    color: #FFFFFF !important;
    box-shadow: 0 3px 10px rgba(95, 141, 122, 0.25) !important;
  }

  .nav-btn-signup {
    background-color: #5F8D7A !important;
    color: #FFFFFF !important;
    border: 1.5px solid #5F8D7A !important;
    padding: 0.45rem 1.2rem !important;
    font-weight: 600 !important;
    border-radius: 25px !important;
    box-shadow: 0 3px 10px rgba(95, 141, 122, 0.25) !important;
    margin-left: 0.25rem;
  }

  .nav-btn-signup:hover {
    background-color: #4E7867 !important;
    border-color: #4E7867 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(78, 120, 103, 0.35) !important;
  }

  /* Search Container & Bar */
  .search-form-container {
    background: #FFFFFF;
    border: 1px solid #E6EADF;
    border-radius: 40px;
    padding: 4px 5px 4px 16px;
    box-shadow: 0 2px 12px rgba(95, 141, 122, 0.06);
    transition: all 0.3s ease;
    max-width: 420px;
    width: 100%;
  }

  .search-form-container:focus-within {
    border-color: #5F8D7A;
    box-shadow: 0 4px 20px rgba(95, 141, 122, 0.2);
  }

  .search-input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0.4rem 0.5rem !important;
    font-size: 0.92rem;
    color: #2F2F2F;
    font-weight: 400;
  }

  .search-input::placeholder {
    color: #8A9389;
    font-weight: 400;
  }

  .search-btn {
    background: #5F8D7A !important;
    color: #FFFFFF !important;
    border-radius: 30px !important;
    padding: 0.45rem 1.25rem !important;
    font-weight: 600 !important;
    font-size: 0.88rem !important;
    border: none !important;
    box-shadow: 0 3px 12px rgba(95, 141, 122, 0.3);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .search-btn:hover {
    background: #4E7867 !important;
    transform: translateY(-1px);
    box-shadow: 0 5px 15px rgba(78, 120, 103, 0.4);
    color: #FFFFFF !important;
  }

  .search-btn i {
    font-size: 0.85rem;
  }

  .navbar-toggler {
    border: 1px solid #E6EADF;
    padding: 0.5rem;
    border-radius: 12px;
    background: #FFFFFF;
    transition: all 0.2s ease;
  }

  .navbar-toggler:focus {
    box-shadow: 0 0 0 3px rgba(95, 141, 122, 0.25);
  }

  @media (max-width: 767.98px) {
    .navbar-collapse {
      padding-top: 1rem;
      padding-bottom: 0.5rem;
    }
    .search-form-container {
      max-width: 100%;
      margin: 0.75rem 0;
    }
    .navbar-nav {
      gap: 0.35rem;
    }
  }
</style>

<nav class="navbar navbar-expand-md custom-navbar sticky-top">
  <div class="container-fluid px-md-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-icon">
        <i class="fa-solid fa-house"></i>
      </div>
      <span class="brand-title">StayEase</span>
    </a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left nav -->
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Search form -->
      <div class="navbar-nav mx-auto">
        <form action="/listings/search" 
              method="GET" 
              class="d-flex align-items-center search-form-container" 
              role="search">
          <input class="form-control me-2 search-input" 
                 type="search" 
                 placeholder="Search destinations" 
                 aria-label="Search" 
                 name="country" />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

      <!-- Right nav -->
      <div class="navbar-nav ms-auto align-items-md-center"> 
        <a class="nav-link" href="/listings/new">Become a Host</a>

        <% if(typeof currUser !== "undefined" && !currUser){ %>
          <a class="nav-link nav-btn-login" href="/login">Login</a>
          <a class="nav-link nav-btn-signup" href="/signup">Signup</a>
        <% } %>

        <% if(typeof currUser !== "undefined" && currUser){ %>
          <a class="nav-link" href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>