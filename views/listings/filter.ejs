 <% layout("layouts/biolerplate") %>
<h3>LISTING HAVING SAME CATEGORY</h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 mb-5">   
   <% for (let i of filterListing) { %>
    <div class="card col listing-card mt-3 mb-3 rounded" style="width: 20rem;">
      <img src="<%= i.image.url %>" class="card-img-top" alt="listing-image" 
       style="height: 20rem"/>
       <div class="card-img-overlay"></div>
       <div class="card-body"> 
        <p class="card-text">
         <b><%= i.title %></b>  <br>
         &#8377; <%= i.price.toLocaleString("en-IN") %>
        </p>
      </div>
    </div>

  <% } %>
</div>