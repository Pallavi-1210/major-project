<% layout("layouts/biolerplate") %>

<body>
<div class="row">

  <!-- TITLE -->
  <div class="col-8 offset-3">
    <h2><%= oneListing.title %></h2>
  </div>

  <!-- LISTING CARD -->
  <div class="col-6 offset-3 show-card listing-card mb-5 mt-5">

    <img src="<%= oneListing.image.url %>" 
      class="card-img-top show-img" 
      alt="listing_image">

    <div class="card-body">
      <p class="card-text">
        <i>Owned by: 
          <%= oneListing.owner ? oneListing.owner.username : "Unknown User" %>
        </i>
      </p>

      <p class="card-text"><%= oneListing.description %></p>

      <p class="card-text">
        &#8377; <%= oneListing.price.toLocaleString("en-IN") %>
      </p>

      <p class="card-text"><%= oneListing.location %></p>
      <p class="card-text"><%= oneListing.country %></p>
    </div>
  </div>

  <!-- EDIT / DELETE -->
  <% if(currUser && oneListing.owner && currUser._id.equals(oneListing.owner._id)) { %>
  <div class="btns mb-4 mt-4">
    <a href="/listings/<%= oneListing._id %>/edit" 
       class="btn btn-dark col-1 offset-3 edit-btn">
      EDIT
    </a>

    <form method="POST"
      action="/listings/<%= oneListing._id %>?_method=DELETE">
      <button class="btn btn-dark offset-4 dlt-btn">DELETE</button>
    </form>
  </div>
  <% } %>

  <!-- MAP -->
  <div class="col-8 offset-3 mb-3">
    <h3>Where you'll be</h3>

    <% if(oneListing.geometry && oneListing.geometry.coordinates && oneListing.geometry.coordinates.length === 2) { %>
      <div id="map"></div>
    <% } else { %>
      <p>Location not available.</p>
    <% } %>
  </div>

  <!-- MAP SCRIPT -->
  <script>
    window.coordinates = <%-JSON.stringify(oneListing.geometry?.coordinates || null) %>;
    window.listingTitle = <%-JSON.stringify(oneListing.title || "Location") %>;
  </script>

  <script src="/js/map.js"></script>

  <!-- REVIEWS SECTION -->
  <div class="col-8 offset-3">
    <hr>

    <% if(currUser) { %>
    <h3>Leave a review</h3>

    <form action="/listings/<%= oneListing._id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation">

      <!-- STAR RATING -->
      <div class="mb-3 mt-3">
        <label class="form-label">Rating:</label>

        <fieldset class="starability-slot">

          <input type="radio" id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="1"
            checked />

          <input type="radio" id="rate1"
            name="review[rating]" value="1" />
          <label for="rate1">1 star</label>

          <input type="radio" id="rate2"
            name="review[rating]" value="2" />
          <label for="rate2">2 stars</label>

          <input type="radio" id="rate3"
            name="review[rating]" value="3" />
          <label for="rate3">3 stars</label>

          <input type="radio" id="rate4"
            name="review[rating]" value="4" />
          <label for="rate4">4 stars</label>

          <input type="radio" id="rate5"
            name="review[rating]" value="5" />
          <label for="rate5">5 stars</label>

        </fieldset>
      </div>

      <!-- COMMENT -->
      <div class="mb-3 mt-3">
        <label class="form-label">Comment:</label>
        <textarea class="form-control"
          name="review[comment]"
          rows="5"
          required></textarea>
      </div>

      <button class="btn btn-dark add-btn mt-3 mb-3">
        submit
      </button>
    </form>
    <% } %>

    <!-- DISPLAY REVIEWS -->
    <% if(oneListing.reviews && oneListing.reviews.length > 0) { %>

      <h4><b>All reviews</b></h4>

      <% for(let review of oneListing.reviews){ %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">

            <h5 class="card-title">
              @<%= review.author.username %>
            </h5>

            <p class="starability-result"
              data-rating="<%= review.rating %>"></p>

            <p class="card-text"><%= review.comment %></p>

          </div>

          <form method="POST"
            action="/listings/<%= oneListing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-dark btn-sm">delete</button>
          </form>
        </div>
      <% } %>

    <% } %>

  </div>

</div>
</body>