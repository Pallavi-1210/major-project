<% layout("layouts/biolerplate") %>
  <h3>LISTINGS IN SAME COUNTRY</h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 mb-5">   
  <% for (let i of searchListing) { %>
  <a href="/listings/<%= i._id %>" class="listing-link">
  <div class="card col listing-card mt-3 mb-3 rounded">
    <img src="<%= i.image.url %>" 
       class="card-img-top" 
       alt="listing-image" 
       style="height: 20rem"/>
    <div class="card-body"> 
      <p class="card-text">
      <b><%= i.title %></b>  <br>
      &#8377; <%= i.price.toLocaleString("en-IN") %>
      <i class="tax-info">&nbsp &nbsp +18%GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>
