<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayEase | Luxury Travel & Accommodations</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --primary: #5F8D7A;
            --primary-hover: #4E7867;
            --bg-cream: #FCFCF8;
            --card-bg: #FFFFFF;
            --border-color: #E6EADF;
            --text-dark: #2F2F2F;
            --text-muted: #6B7280;
            --shadow-sm: 0 4px 12px rgba(95, 141, 122, 0.05);
            --shadow-md: 0 10px 30px rgba(95, 141, 122, 0.08);
            --shadow-lg: 0 20px 40px rgba(95, 141, 122, 0.12);
            --radius-lg: 20px;
            --radius-md: 14px;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        h1,
        h2,
        h3,
        .font-serif {
            font-family: 'Playfair Display', serif;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, rgba(47, 47, 47, 0.35) 0%, rgba(47, 47, 47, 0.6) 100%),
                url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
            color: #FFFFFF;
            text-align: center;
            padding: 6rem 1.5rem;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(252, 252, 248, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #FFFFFF;
            padding: 0.5rem 1.25rem;
            border-radius: 30px;
            font-size: 0.88rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            letter-spacing: 0.03em;
        }

        .hero-title {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 1.25rem;
            letter-spacing: -0.01em;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .hero-subtitle {
            font-size: clamp(1.05rem, 2vw, 1.3rem);
            font-weight: 300;
            max-width: 680px;
            margin: 0 auto 2.5rem;
            opacity: 0.95;
            line-height: 1.6;
        }

        .btn-hero {
            background-color: var(--primary);
            color: #FFFFFF !important;
            border: none;
            padding: 1rem 2.5rem;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 35px;
            box-shadow: var(--shadow-md);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }

        .btn-hero:hover {
            background-color: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
            color: #FFFFFF !important;
        }

        /* Section Styling */
        .section-padding {
            padding: 6rem 0;
        }

        .section-header {
            text-align: center;
            max-width: 620px;
            margin: 0 auto 4rem;
        }

        .section-subtitle {
            color: var(--primary);
            text-transform: uppercase;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            margin-bottom: 0.75rem;
            display: block;
        }

        .section-title {
            font-size: clamp(2rem, 3.5vw, 2.75rem);
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1rem;
        }

        .section-desc {
            color: var(--text-muted);
            font-size: 1.05rem;
            line-height: 1.6;
        }

        /* Popular Categories */
        .category-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 2.25rem 1.5rem;
            text-align: center;
            transition: all 0.35s ease;
            box-shadow: var(--shadow-sm);
            height: 100%;
            cursor: pointer;
        }

        .category-card:hover {
            transform: translateY(-8px);
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
            background: #FFFFFF;
        }

        .category-icon {
            width: 64px;
            height: 64px;
            background: rgba(95, 141, 122, 0.1);
            color: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin: 0 auto 1.25rem;
            transition: all 0.3s ease;
        }

        .category-card:hover .category-icon {
            background: var(--primary);
            color: #FFFFFF;
            transform: scale(1.1);
        }

        .category-name {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.4rem;
        }

        .category-count {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* Why Choose Us */
        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 3rem 2rem;
            text-align: center;
            transition: all 0.35s ease;
            box-shadow: var(--shadow-sm);
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--primary);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-icon-wrapper {
            width: 76px;
            height: 76px;
            background: rgba(95, 141, 122, 0.08);
            color: var(--primary);
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 1.75rem;
            transition: all 0.3s ease;
        }

        .feature-card:hover .feature-icon-wrapper {
            background: var(--primary);
            color: #FFFFFF;
            transform: rotate(5deg);
        }

        .feature-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 0.85rem;
            color: var(--text-dark);
        }

        .feature-desc {
            color: var(--text-muted);
            font-size: 0.98rem;
            line-height: 1.65;
        }

        /* Featured Properties Preview */
        .property-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .property-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: var(--border-color);
        }

        .property-img-wrapper {
            position: relative;
            width: 100%;
            height: 240px;
            overflow: hidden;
        }

        .property-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .property-card:hover .property-img {
            transform: scale(1.08);
        }

        .property-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background: rgba(252, 252, 248, 0.9);
            backdrop-filter: blur(8px);
            color: var(--text-dark);
            padding: 0.35rem 0.85rem;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .property-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .property-location {
            font-size: 0.85rem;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .property-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 0.75rem;
            line-height: 1.35;
        }

        .property-footer {
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .property-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        .property-price span {
            font-size: 0.88rem;
            font-weight: 400;
            color: var(--text-muted);
        }

        .btn-view-all {
            background-color: var(--primary);
            color: #FFFFFF !important;
            border: none;
            padding: 0.9rem 2.25rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 30px;
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-view-all:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        @media (max-width: 767.98px) {
            .section-padding {
                padding: 4rem 0;
            }

            .hero-section {
                min-height: 75vh;
                padding: 4rem 1rem;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar Include -->
    <%- include("includes/navbar.ejs") %>

        <!-- Hero Section -->
        <header class="hero-section">
            <div class="container">

                <div class="hero-badge">
                    <i class="fa-solid fa-earth-americas"></i> Explore • Stay • Host
                </div>

                <h1 class="hero-title">
                    Discover Amazing Places or Share Your Own
                </h1>

                <p class="hero-subtitle">
                    Explore unique stays around the world or become a host and list your property for travelers looking
                    for their next unforgettable experience.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">

                    <a href="/listings" class="btn btn-hero">
                        Explore Stays
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                    <a href="/listings/new" class="btn btn-hero">
                        <i class="fa-solid fa-plus me-2"></i>
                        Become a Host
                    </a>

                </div>

            </div>
        </header>

        <!-- Trending Categories Section -->
        <section class="section-padding">
            <div class="container">
                <div class="section-header">
                    <span class="section-subtitle">Explore</span>
                    <h2 class="section-title">Trending Categories</h2>
                    <p class="section-desc">
                        Discover stays based on your travel style and favourite experiences.
                    </p>
                </div>

                <div class="row g-4">

                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Trending" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-fire"></i>
                                </div>
                                <h3 class="category-name">Trending</h3>
                                <span class="category-count">Popular stays</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Rooms" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-bed"></i>
                                </div>
                                <h3 class="category-name">Rooms</h3>
                                <span class="category-count">Comfortable stays</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Iconic Cities" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-building"></i>
                                </div>
                                <h3 class="category-name">Iconic Cities</h3>
                                <span class="category-count">City experiences</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Mountains" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-mountain"></i>
                                </div>
                                <h3 class="category-name">Mountains</h3>
                                <span class="category-count">Nature escapes</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Castles" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-brands fa-fort-awesome"></i>
                                </div>
                                <h3 class="category-name">Castles</h3>
                                <span class="category-count">Historic stays</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Amazing Pools" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-person-swimming"></i>
                                </div>
                                <h3 class="category-name">Amazing Pools</h3>
                                <span class="category-count">Luxury relaxation</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Camping" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-campground"></i>
                                </div>
                                <h3 class="category-name">Camping</h3>
                                <span class="category-count">Outdoor adventures</span>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/listings/category?category=Farms" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa-solid fa-cow"></i>
                                </div>
                                <h3 class="category-name">Farms</h3>
                                <span class="category-count">Peaceful escapes</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Choose Us Section -->
        <section class="section-padding" style="background-color: #F7F8F4;">
            <div class="container">
                <div class="section-header">
                    <span class="section-subtitle">Why StayEase</span>
                    <h2 class="section-title">Everything You Need For A Perfect Stay</h2>
                    <p class="section-desc">
                        Find comfortable stays, connect with hosts, and enjoy a smooth booking experience.
                    </p>
                </div>

                <div class="row g-4">

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon-wrapper">
                                <i class="fa-solid fa-house-circle-check"></i>
                            </div>
                            <h3 class="feature-title">Explore Unique Stays</h3>
                            <p class="feature-desc">
                                Discover different types of properties with images, details, pricing, and locations.
                            </p>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon-wrapper">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <h3 class="feature-title">Find Perfect Locations</h3>
                            <p class="feature-desc">
                                Search properties easily and explore their locations with interactive maps.
                            </p>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon-wrapper">
                                <i class="fa-solid fa-comments"></i>
                            </div>
                            <h3 class="feature-title">Real Guest Reviews</h3>
                            <p class="feature-desc">
                                Read genuine reviews from travellers and share your own experience.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Featured Properties Section -->
            <section class="section-padding">
                <div class="container">

                    <div class="section-header">
                        <span class="section-subtitle">Popular Stays</span>
                        <h2 class="section-title">Featured Properties</h2>
                        <p class="section-desc">
                            Explore beautiful stays with amazing locations, comfortable spaces, and memorable
                            experiences.
                        </p>
                    </div>


                    <div class="row g-4">


                        <!-- Property 1 -->
                        <div class="col-md-6 col-lg-3">
                            <div class="property-card">
                                <div class="property-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=80"
                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';"
                                        alt="Cozy Beachfront Cottage" class="property-img">
                                    <span class="property-badge">Beachfront</span>
                                </div>
                                <div class="property-content">
                                    <div class="property-location">
                                        <i class="fa-solid fa-location-dot"></i> Malibu, United States
                                    </div>
                                    <h3 class="property-title">
                                        Cozy Beachfront Cottage
                                    </h3>
                                    <div class="property-footer">
                                        <div class="property-price">
                                            ₹1500 <span>/ night</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Property 2 -->
                        <div class="col-md-6 col-lg-3">
                            <div class="property-card">
                                <div class="property-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=800&q=80"
                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';"
                                        alt="Modern Loft" class="property-img">
                                    <span class="property-badge">Trending</span>
                                </div>
                                <div class="property-content">
                                    <div class="property-location">
                                        <i class="fa-solid fa-location-dot"></i> New York City, United States
                                    </div>
                                    <h3 class="property-title">
                                        Modern Loft in Downtown
                                    </h3>
                                    <div class="property-footer">
                                        <div class="property-price">
                                            ₹1200 <span>/ night</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Property 3 -->
                        <div class="col-md-6 col-lg-3">
                            <div class="property-card">
                                <div class="property-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=80"
                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';"
                                        alt="Mountain Retreat" class="property-img">
                                    <span class="property-badge">Mountains</span>
                                </div>
                                <div class="property-content">
                                    <div class="property-location">
                                        <i class="fa-solid fa-location-dot"></i> Aspen, United States
                                    </div>
                                    <h3 class="property-title">
                                        Mountain Retreat
                                    </h3>
                                    <div class="property-footer">
                                        <div class="property-price">
                                            ₹1000 <span>/ night</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Property 4 -->
                        <div class="col-md-6 col-lg-3">
                            <div class="property-card">
                                <div class="property-img-wrapper">
                                    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80"
                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';"
                                        alt="Historic Villa" class="property-img">
                                    <span class="property-badge">Luxury Villa</span>
                                </div>
                                <div class="property-content">
                                    <div class="property-location">
                                        <i class="fa-solid fa-location-dot"></i> Florence, Italy
                                    </div>
                                    <h3 class="property-title">
                                        Historic Villa in Tuscany
                                    </h3>
                                    <div class="property-footer">
                                        <div class="property-price">
                                            ₹2500 <span>/ night</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                    </div>


                    <div class="text-center mt-5">

                        <a href="/listings" class="btn btn-view-all">
                            View All Properties
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Footer Include -->
            <%- include("includes/footer.ejs") %>

                <!-- Bootstrap 5 JS Bundle -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>